genrule(
    name = "site",
    srcs = [
        "//:CHANGELOG.md",
        "//:docs/Roadmap.md",
        "//:docs/Guide.md",
        "_template.html",
        "build.py",
    ],
    outs = [
        "changelog.html",
        "roadmap.html",
        "guide.html",
    ],
    cmd = " ".join([
        "python3 $(location build.py)",
        "--changelog $(location //:CHANGELOG.md)",
        "--roadmap   $(location //:docs/Roadmap.md)",
        "--guide     $(location //:docs/Guide.md)",
        "--template  $(location _template.html)",
        "--outdir    $(@D)",
    ]),
)
