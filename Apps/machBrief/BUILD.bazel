load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_apple//apple:macos.bzl", "macos_application", "macos_extension")

swift_library(
    name = "machBriefWidget_Lib",
    srcs = glob(["machBriefWidget/**/*.swift"]),
    module_name = "machBriefWidget",
    deps = ["//Packages/MachBriefKit"],
)

swift_library(
    name = "machBrief_Lib",
    srcs = glob(["machBrief/**/*.swift"]),
    module_name = "machBrief",
    deps = ["//Packages/MachBriefKit"],
)

macos_extension(
    name = "machBriefWidget",
    bundle_id = "mach.brief.widget",
    entitlements = "machBriefWidget/machBriefWidget.entitlements",
    infoplists = ["machBriefWidget/Info.plist"],
    minimum_os_version = "26.0",
    deps = [":machBriefWidget_Lib"],
)

macos_application(
    name = "machBrief",
    bundle_id = "mach.brief",
    entitlements = "machBrief/machBrief.entitlements",
    infoplists = ["machBrief/Info.plist"],
    minimum_os_version = "26.0",
    deps = [":machBrief_Lib"],
    extensions = [":machBriefWidget"],
    visibility = ["//visibility:public"],
)
