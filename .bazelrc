build --verbose_failures
build --apple_generate_dsym

# CI profile — activate with --config=ci
build:ci --noshow_progress
build:ci --show_result=0
build:ci --color=no
build:ci --keep_going
build:ci --announce_rc
# Skip DSYM generation in CI — it's slow and the artifacts aren't used.
build:ci --noapple_generate_dsym
# Print test failure output so CI logs are debuggable.
build:ci --test_output=errors
# Saturate all available cores on the runner.
build:ci --jobs=HOST_CPUS
# Separate content-addressed cache for downloaded external repos.
# Keyed on MODULE.bazel + Package.resolved so it survives BUILD file changes.
build:ci --repository_cache=~/.cache/bazel-repos
