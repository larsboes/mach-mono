build --verbose_failures
build --apple_generate_dsym
# Only show build output (warnings/errors) from first-party targets.
# External Swift packages (SkyLightWindow, Defaults, AsyncXPCConnection, etc.)
# produce deprecation warnings we can't fix — filter them out of the build log.
build --output_filter=^//

# Workspace status command — outputs are available to stamped actions.
# Versioning flows through `apple_bundle_version` reading BUILD_EMBED_LABEL
# (set by `--embed_label` in CI), not the STABLE_* keys directly.
build --workspace_status_command=tools/workspace_status.sh

# CI profile — activate with --config=ci
build:ci --noshow_progress
build:ci --show_result=0
build:ci --color=no
build:ci --keep_going
build:ci --announce_rc
# Skip DSYM generation in CI — it's slow and the artifacts aren't used.
build:ci --noapple_generate_dsym
# Print test failure output so CI logs are debuggable.
build:ci --test_output=errors
# Saturate all available cores on the runner.
build:ci --jobs=HOST_CPUS
# Enforce strict lockfile mode in CI to prevent stealth dependency drift.
build:ci --lockfile_mode=error
# Separate content-addressed cache for downloaded external repos.
# Keyed on MODULE.bazel + Package.resolved so it survives BUILD file changes.
build:ci --repository_cache=~/.cache/bazel-repos
