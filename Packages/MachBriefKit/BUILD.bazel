load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")
load("@rules_apple//apple:resources.bzl", "apple_resource_bundle")

apple_resource_bundle(
    name = "MachBriefKit_Resources",
    bundle_name = "MachBriefKit_MachBriefKit",
    # Single source of truth: the SPM target's resource directory (also
    # referenced by Package.swift's `.process("Resources")`). Do not
    # reintroduce a package-root `Resources/` directory — a prior duplicate
    # there drifted out of sync (missing quotes_de.json, stale word lists)
    # and shipped silently broken in Bazel release builds.
    resources = glob(["Sources/MachBriefKit/Resources/**"]),
)

swift_library(
    name = "MachBriefKit",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "MachBriefKit",
    visibility = ["//visibility:public"],
    deps = [],
    data = [":MachBriefKit_Resources"],
    defines = ["SWIFT_PACKAGE"], 
)

swift_test(
    name = "MachBriefKitTests",
    srcs = glob(["Tests/**/*.swift"]),
    deps = [":MachBriefKit"],
)
