load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")
load("@rules_apple//apple:resources.bzl", "apple_resource_bundle")

apple_resource_bundle(
    name = "MachBriefKit_Resources",
    bundle_name = "MachBriefKit_MachBriefKit",
    resources = glob(["Resources/**"]),
)

swift_library(
    name = "MachBriefKit",
