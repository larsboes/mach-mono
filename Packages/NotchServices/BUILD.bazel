load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("//resources/tools:defs.bzl", "MINIMUM_MACOS_VERSION")

swift_library(
    name = "NotchServices",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "NotchServices",
    visibility = ["//visibility:public"],
    deps = [
        "//Packages/NotchCore:NotchCore",
        "//Packages/MacroVisionKit:MacroVisionKit",
        "@swiftpkg_asyncxpcconnection//:AsyncXPCConnection",
        "@swiftpkg_defaults//:Defaults",
        "@swiftpkg_keyboardshortcuts//:KeyboardShortcuts",
        "@swiftpkg_sparkle//:Sparkle",
        "@swiftpkg_sqlite.swift//:SQLite",
    ],
    defines = ["SWIFT_PACKAGE"],
)

swift_library(
    name = "NotchServicesTests_Lib",
    srcs = glob(["Tests/**/*.swift"]),
    deps = [":NotchServices"],
    testonly = True,
)

macos_unit_test(
    name = "NotchServicesTests",
    bundle_id = "com.larsboes.NotchServicesTests",
    minimum_os_version = MINIMUM_MACOS_VERSION,
    deps = [":NotchServicesTests_Lib"],
)
