swift_library(
    name = "NotchPlugins",
    srcs = [
        "Sources/NotchPlugins/BuiltInPluginViewBridge.swift",
        "Sources/NotchPlugins/Core/PluginRegistry.swift",
        "Sources/NotchPlugins/Imports.swift",
        "Sources/NotchPlugins/NotchPlugins.swift",
    ],
    module_name = "NotchPlugins",
    visibility = ["//visibility:public"],
    deps = [
        ":NotchBatteryPlugin",
        ":NotchBriefPlugin",
        ":NotchCalendarPlugin",
        ":NotchClipboardPlugin",
        ":NotchDisplaySurfacePlugin",
        ":NotchHabitTrackerPlugin",
        ":NotchMusicPlugin",
        ":NotchNotificationsPlugin",
        ":NotchPluginCore",
        ":NotchPomodoroPlugin",
        ":NotchShelfPlugin",
        ":NotchSystemStatsPlugin",
        ":NotchTeleprompterPlugin",
        ":NotchWeatherPlugin",
        ":NotchWebcamPlugin",
        "//Packages/NotchCore:NotchCore",
        "//Packages/NotchServices:NotchServices",
        "//Packages/NotchUI:NotchUI",
    ],
    defines = ["SWIFT_PACKAGE"],
)

swift_library(
    name = "NotchPluginsWithSoundscape",
    srcs = ["Sources/NotchPlugins/SoundscapePluginRegistry.swift"],
    module_name = "NotchPluginsWithSoundscape",
    visibility = ["//visibility:public"],
    deps = [
        ":NotchPlugins",
        ":NotchSoundscapePlugin",
    ],
    defines = ["SWIFT_PACKAGE"],
)

swift_library(
    name = "NotchPluginsTests_Lib",
    srcs = glob(["Tests/**/*.swift"]),
    deps = [
        ":NotchPlugins",
        ":NotchSoundscapePlugin",
    ],
    testonly = True,
)

macos_unit_test(
    name = "NotchPluginsTests",
    bundle_id = "com.larsboes.NotchPluginsTests",
    minimum_os_version = MINIMUM_MACOS_VERSION,
    deps = [":NotchPluginsTests_Lib"],
)
