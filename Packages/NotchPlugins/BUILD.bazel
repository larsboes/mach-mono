load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("//resources/tools:defs.bzl", "MINIMUM_MACOS_VERSION")
load(":notch_plugin_defs.bzl", "notch_plugin_library")

swift_library(
    name = "NotchPluginCore",
    srcs = glob(
        [
            "Sources/NotchPlugins/Core/**/*.swift",
            "Sources/NotchPlugins/UI/**/*.swift",
        ],
        exclude = ["Sources/NotchPlugins/Core/PluginRegistry.swift"],
    ),
    module_name = "NotchPluginCore",
    visibility = ["//visibility:public"],
    deps = [
        "//Packages/NotchCore:NotchCore",
        "//Packages/NotchServices:NotchServices",
        "//Packages/NotchUI:NotchUI",
        "@swiftpkg_defaults//:Defaults",
    ],
    defines = ["SWIFT_PACKAGE"],
)

notch_plugin_library(
    name = "NotchBatteryPlugin",
    module_name = "NotchBatteryPlugin",
    path = "BatteryPlugin",
)

