module(
    name = "mach_mono",
    version = "0.0.1",
)

bazel_dep(name = "apple_support", version = "2.5.4")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_apple", version = "4.5.3")
bazel_dep(name = "rules_swift", version = "3.6.1")
bazel_dep(name = "rules_swift_package_manager", version = "1.15.0")

# Patch rules_apple to add SupportedPlatforms to the macOS xctestrun template.
# Without this, bazelisk test fails to identify the platform and skips test execution.
single_version_override(
    module_name = "rules_apple",
    version = "4.5.3",
    patches = ["//.bazel/patches:rules_apple_xctestrun_macos_platform.patch"],
    patch_strip = 1,
)

# Local C++ JSON library — retained for future C++/Swift interop.
bazel_dep(name = "nlohmann_json", version = "3.11.3")
local_path_override(
    module_name = "nlohmann_json",
    path = "external/nlohmann_json",
)

swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    resolved = "//:Package.resolved",
    swift = "//:Package.swift",
)
use_repo(
    swift_deps,
    "swift_package",
    "swiftpkg_asyncxpcconnection",
    "swiftpkg_defaults",
    "swiftpkg_keyboardshortcuts",
    "swiftpkg_launchatlogin_modern",
    "swiftpkg_lottie_spm",
    "swiftpkg_pow",
    "swiftpkg_skylightwindow",
    "swiftpkg_sparkle",
    "swiftpkg_sqlite.swift",
    "swiftpkg_swift_collections",
    "swiftpkg_swiftglass",
)
